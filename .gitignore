# Local TLS certs (mkcert) - machine-specific, regenerate with:
#   mkcert -install && mkcert -key-file deploy/keycloak/localhost-key.pem -cert-file deploy/keycloak/localhost.pem localhost
deploy/keycloak/*.pem
deploy/**/README.md
deploy/scripts

# Ansible vault passphrase (never the vault.yml it decrypts - that's meant to be committed encrypted)

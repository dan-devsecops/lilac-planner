# Managed by Ansible - deploy/ansible/bootstrap.yml ("Render .env.prod" task).
# edit deploy/ansible/group_vars/droplet/vault.yml (ansible-vault edit) and re-run `ansible-playbook bootstrap.yml` instead - a manual edit here just gets overwritten on the next run.
#
# Mirrors the env vars docker-compose.prod.yml reads

REGISTRY_SERVER={{ registry_server }}
{# domain: only set this in vault.yml for a real domain - omitted/blank falls back to
   the droplet's current IP (from the dynamic inventory) + nip.io's free wildcard DNS,
   so it tracks IP changes across droplet recreates with no vault edit needed. #}
DOMAIN={{ domain | default('') or (ansible_host ~ '.nip.io') }}

AUTH_PROVIDER={{ auth_provider | default('none') }}
PLANNER_JWT_SECRET={{ planner_jwt_secret | default('') }}

PLANNER_ADMIN_USERNAME={{ planner_admin_username | default('') }}
PLANNER_ADMIN_PASSWORD={{ planner_admin_password | default('') }}
PLANNER_ADMIN_EMAIL={{ planner_admin_email | default('') }}

MAIL_HOST={{ mail_host | default('') }}
MAIL_PORT={{ mail_port | default('587') }}
MAIL_USER={{ mail_user | default('') }}
MAIL_PASSWORD={{ mail_password | default('') }}

MARIADB_USER={{ mariadb_user }}
MARIADB_PASSWORD={{ mariadb_password }}
MARIADB_ROOT_PASSWORD={{ mariadb_root_password }}
MARIADB_DB={{ mariadb_db | default('lilac_planner') }}

PLANNER_VAPID_PUBLIC_KEY={{ planner_vapid_public_key | default('') }}
PLANNER_VAPID_PRIVATE_KEY={{ planner_vapid_private_key | default('') }}
PLANNER_VAPID_SUBJECT={{ planner_vapid_subject | default('') }}
EXPO_ACCESS_TOKEN={{ expo_access_token | default('') }}

PLANNER_METRICS_PASSWORD={{ planner_metrics_password }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

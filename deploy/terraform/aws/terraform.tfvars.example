# Copy to terraform.tfvars and adjust. No secrets - the DB password is
# generated and stored in Secrets Manager by Terraform.
prefix             = "lilac"
region             = "eu-west-1"
node_count         = 2
node_instance_type = "t3.medium"
db_instance_class  = "db.t4g.micro"

enable_github_oidc = true
github_repository  = "your-org/lilac-planner"

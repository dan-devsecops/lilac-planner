# ServiceAccount + SecretStore + ExternalSecrets that replace the old
# "Sync DB + auth secrets from Key Vault" kubectl-create-secret CI step.
# Rendered with envsubst by .github/workflows/cd-azure.yml and committed to
# main (same pattern as values-current.yaml) - ArgoCD's "lilac-azure-secrets"
# Application (see argocd-app.yaml.tmpl) watches it and reconciles
# continuously, so lilac-db/lilac-auth are now real GitOps-managed state
# instead of a one-shot imperative CI action.
#
# The actual Key Vault values never appear here or anywhere in git - ESO
# fetches them live at sync time using Workload Identity (see
# deploy/terraform/azure/external-secrets.tf).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: lilac-external-secrets
  namespace: lilac-planner
  annotations:
    azure.workload.identity/client-id: "${ESO_CLIENT_ID}"
---
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: azure-keyvault
  namespace: lilac-planner
spec:
  provider:
    azurekv:
      authType: WorkloadIdentity
      vaultUrl: "https://${KEYVAULT_NAME}.vault.azure.net"
      tenantId: "${AZURE_TENANT_ID}"
      serviceAccountRef:
        name: lilac-external-secrets
---
# Keys here match backend.plannerDb=postgres's expected env names (see
# _helpers.tpl's db.*EnvName helpers) - same keys the old kubectl secret used.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: lilac-db
  namespace: lilac-planner
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: azure-keyvault
    kind: SecretStore
  target:
    name: lilac-db
    creationPolicy: Owner
  data:
    - secretKey: PG_USER
      remoteRef:
        key: pg-user
    - secretKey: PG_PASSWORD
      remoteRef:
        key: pg-password
    - secretKey: PG_URL
      remoteRef:
        key: pg-url
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: lilac-auth
  namespace: lilac-planner
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: azure-keyvault
    kind: SecretStore
  target:
    name: lilac-auth
    creationPolicy: Owner
  data:
    - secretKey: PLANNER_JWT_SECRET
      remoteRef:
        key: native-jwt-secret
    - secretKey: PLANNER_ADMIN_PASSWORD
      remoteRef:
        key: native-admin-password

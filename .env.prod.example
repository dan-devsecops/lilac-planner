# Env file for docker-compose.prod.yml on the Droplet (/opt/lilac-planner/.env.prod).
#
# `ansible-playbook bootstrap.yml` renders it from deploy/ansible/templates/env.prod.j2 + deploy/ansible/group_vars/droplet/vault.yml
#
# Generate strong passwords with: openssl rand -base64 24

REGISTRY_SERVER=
DOMAIN=

AUTH_PROVIDER=
PLANNER_JWT_SECRET=

PLANNER_ADMIN_USERNAME=
PLANNER_ADMIN_PASSWORD=
PLANNER_ADMIN_EMAIL=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

MARIADB_USER=planner
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DB=lilac_planner

PLANNER_VAPID_PUBLIC_KEY=
PLANNER_VAPID_PRIVATE_KEY=
PLANNER_VAPID_SUBJECT=
EXPO_ACCESS_TOKEN=

PLANNER_METRICS_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

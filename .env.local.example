# Copy to .env.local (gitignored - never commit the real token) and fill in.
# sonar-scan.sh sources this file itself on every run, so SONAR_TOKEN survives
# a reboot without a manual `export` or any extra tooling.
#
# Generate the token in the local SonarQube UI: My Account -> Security ->
# Generate Token (type: User Token). See docker-compose-sonarqube.yml for setup.
SONAR_TOKEN=

# Only needed if your local SonarQube isn't on the default port.
# SONAR_HOST_URL=http://localhost:9000

# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* vars at build/bundle time.
#
# Android emulator talking to a backend on your host machine: keep the default (10.0.2.2 is the
# emulator's alias for the host's localhost). iOS Simulator can use http://localhost:8090 instead.
# A physical device needs your machine's LAN IP: http://192.168.x.x:8090 (same Wi-Fi network).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8090
